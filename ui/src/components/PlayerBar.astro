<!-- 底部播放条：容器占位（布局待定）。提供跨页共享的播放全局 window.QuaverPlayer，
     页面脚本用 playUrl(url, song) 驱动。多页跳转时声音会重置——MPA 阶段可接受，
     壳层/SPA 化后再做持续播放。 -->
<div class="player" id="player-bar">
  <div class="cover" id="pb-cover"></div>
  <div class="now">
    <div class="t" id="pb-title">未在播放</div>
    <div class="s" id="pb-sub">点一首歌试试</div>
  </div>
  <audio id="pb-audio" controls></audio>
  <span class="hint" id="pb-hint"></span>
</div>

<script>
  const audio = document.getElementById("pb-audio") as HTMLAudioElement;
  const cover = document.getElementById("pb-cover")!;
  const title = document.getElementById("pb-title")!;
  const sub = document.getElementById("pb-sub")!;
  const hint = document.getElementById("pb-hint")!;

  function markPlaying(song: any) {
    document.querySelectorAll(".playing").forEach((e) => e.classList.remove("playing"));
    if (!song?._key) return;
    document.querySelectorAll(`[data-songkey="${CSS.escape(song._key)}"]`).forEach((e) => e.classList.add("playing"));
  }

  (window as any).QuaverPlayer = {
    playUrl(url: string, song: any) {
      hint.textContent = "";
      audio.src = url;
      audio.play().catch((e) => (hint.textContent = "播放失败: " + e.message));
      title.textContent = song?.name ?? "";
      sub.textContent = (song?.singer ?? []).map((x: any) => x.name).join(" / ");
      const pic = song?.album?.pmid
        ? `https://y.gtimg.cn/music/photo_new/T002R300x300M000${song.album.pmid.split("_")[0]}_1.jpg`
        : "";
      cover.innerHTML = pic ? `<img src="${pic}" alt=""/>` : "";
      markPlaying(song);
    },
    mark(song: any) { markPlaying(song); },
    get audio() { return audio; },
  };
</script>
