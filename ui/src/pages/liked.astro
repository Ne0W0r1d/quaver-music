---
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="我喜欢">
  <h2>我喜欢 <span class="muted" id="cnt"></span></h2>
  <div class="rows" id="rows"><div class="muted">加载中…</div></div>
</AppLayout>

<script>
  import { loadLiked } from "../lib/songs";
  loadLiked(document.getElementById("rows")!)
    .then(() => {
      const n = document.querySelectorAll("#rows .row").length;
      document.getElementById("cnt")!.textContent = n ? `· ${n} 首` : "";
    })
    .catch((e) => ($("#rows") as HTMLElement).innerHTML = `<div class="muted">${e.message} — 需要先登录</div>`);
  const $ = (s: string) => document.querySelector(s)!;
</script>
