---
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="猜你喜欢">
  <h2>猜你喜欢</h2>
  <p class="muted" style="margin:-6px 0 14px">fork 未提供个性化推荐端点；先以「我喜欢」随机序呈现，二期接入推荐 CGI。</p>
  <div class="rows" id="rows"><div class="muted">加载中…</div></div>
</AppLayout>

<script>
  import { api } from "../lib/api";
  import { renderSongRows } from "../lib/songs";

  const box = document.getElementById("rows")!;
  (async () => {
    const pool: any[] = [];
    for (let off = 0; off < 150; off += 30) {
      const p: any = await api(`/user/liked-songs?offset=${off}&limit=30`);
      pool.push(...(p?.songs ?? []));
      if (!p?.more) break;
    }
    // 洗牌后取 50 首
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    renderSongRows(box, pool.slice(0, 50));
  })().catch((e) => (box.innerHTML = `<div class="muted">${e.message} — 需要先登录</div>`));
</script>
